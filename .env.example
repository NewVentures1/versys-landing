# Resend API key for the waitlist email backend.
# Sign up at https://resend.com, verify the versysinc.com domain
# (add SPF/DKIM/DMARC DNS records they provide), and create an API key.
RESEND_API_KEY=re_your_key_here

# Sender address — must be on a verified domain.
RESEND_FROM_EMAIL=waitlist@versysinc.com

# Where new waitlist signups arrive.
RESEND_TO_EMAIL=support@versysinc.com
