---
import AnimatedCounter from "../ui/AnimatedCounter";
---

<section
  id="hero"
  class="relative min-h-[85vh] flex items-center justify-center pt-32 pb-16 overflow-hidden"
>
  <!-- Gradient orbs background -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <div class="gradient-orb bg-brand-green/25 w-[600px] h-[600px] -top-32 -left-32"></div>
    <div class="gradient-orb bg-brand-green/15 w-[500px] h-[500px] top-1/2 -right-32 -translate-y-1/2"></div>
    <div class="gradient-orb bg-blue-500/10 w-[400px] h-[400px] -bottom-32 left-1/3"></div>
  </div>

  <!-- Subtle grain texture -->
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.04] mix-blend-overlay pointer-events-none"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence baseFrequency=%220.9%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"
  >
  </div>

  <!-- Main content -->
  <div class="relative z-10 max-w-content mx-auto px-6 text-center">
    <h1
      class="text-4xl md:text-6xl lg:text-7xl xl:text-[5.5rem] font-bold tracking-tight leading-[1.0] mb-8 text-balance"
    >
      <span class="hero-rise hero-delay-1 inline-block">Free TMS.</span>{" "}
      <span class="hero-rise hero-delay-2 text-brand-ink-soft inline-block">No setup fees.</span>
      <br />
      <span class="hero-rise hero-delay-3 inline-block">Up to</span>{" "}
      <span class="hero-pop hero-delay-3 font-display gradient-text-green inline-block px-1">$1.40</span>{" "}
      <span class="hero-rise hero-delay-4 inline-block">off every gallon.</span>
    </h1>

    <p
      class="text-base md:text-xl text-brand-ink-soft max-w-2xl mx-auto mb-10 leading-relaxed text-balance"
    >
      The first platform that pays you to use it. Free TMS for your fleet — plus thousands a year back on fuel.
    </p>

    <!-- Savings counter centerpiece -->
    <div class="flex flex-col items-center gap-2 mb-10">
      <span class="text-[11px] sm:text-xs text-brand-ink-faint uppercase tracking-[0.2em] font-semibold">
        Up to · per truck · yr 1
      </span>
      <span class="font-display text-6xl md:text-7xl lg:text-8xl text-brand-green font-bold leading-none">
        <AnimatedCounter client:load from={0} to={25850} duration={2} />
      </span>
      <span class="text-sm md:text-base text-brand-ink-soft mt-1">
        back in your pocket
      </span>
    </div>

    <!-- Primary CTA -->
    <div class="flex justify-center">
      <a
        href="#calculator"
        class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green/90 text-white font-semibold px-8 py-4 rounded-full text-base md:text-lg shadow-lg shadow-brand-green/20 transition-all hover:shadow-xl hover:scale-[1.02]"
      >
        See my savings
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </div>

</section>
