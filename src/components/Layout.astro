---
import "../styles/globals.css";
import TopNav from "./TopNav.astro";
import Footer from "./Footer.astro";
import ScrollContainer from "./ScrollContainer";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  canonicalPath = "/",
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0E12" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Versys" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: load async so the stylesheet doesn't block first paint.
         The preload+onload swap downloads the CSS in parallel with the page
         and applies it once ready; noscript fallback for no-JS clients. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&display=swap"
      />
    </noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": canonicalUrl + "#organization",
          "name": "Versys",
          "url": Astro.site?.toString(),
          "logo": new URL("/logo.png", Astro.site).toString(),
          "sameAs": [],
          "description": "Free TMS software for trucking carriers, paired with a fuel card network offering up to $1.40 per gallon off.",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "400 S. 4th St, Suite 318",
            "addressLocality": "Las Vegas",
            "addressRegion": "NV",
            "postalCode": "89101",
            "addressCountry": "US"
          }
        },
        {
          "@type": "WebSite",
          "@id": canonicalUrl + "#website",
          "url": Astro.site?.toString(),
          "name": "Versys",
          "publisher": { "@id": canonicalUrl + "#organization" },
          "inLanguage": "en-US"
        },
        {
          "@type": "Product",
          "@id": canonicalUrl + "#tms",
          "name": "Versys TMS",
          "description": "Free transportation management system for trucking carriers. Active freight tracking, AR aging, driver settlements, broker management, IFTA-ready fuel data.",
          "brand": { "@id": canonicalUrl + "#organization" },
          "category": "Transportation Management Software",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/PreOrder",
            "url": canonicalUrl
          }
        },
        {
          "@type": "Product",
          "@id": canonicalUrl + "#fuelcard",
          "name": "Versys Fuel Card",
          "description": "Fuel card for trucking carriers, brokers, dispatchers, and factoring companies. Up to $1.40 per gallon off at participating stations across the United States. Zero monthly fees.",
          "brand": { "@id": canonicalUrl + "#organization" },
          "category": "Fuel Card",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/PreOrder",
            "url": canonicalUrl
          }
        }
      ]
    })} />
  </head>
  <body class="bg-brand-dark text-brand-ink antialiased">
    <ScrollContainer client:idle>
      <TopNav />
      <main>
        <slot />
      </main>
      <Footer />
    </ScrollContainer>
  </body>
</html>
