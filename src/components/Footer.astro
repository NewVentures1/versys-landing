---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 mt-32">
  <div class="max-w-content mx-auto px-6 py-12">
    <div id="disclosures" class="mb-10 pb-8 border-b border-white/5">
      <h4 class="text-xs uppercase tracking-wider text-brand-ink-soft mb-3">Disclosures</h4>
      <p class="text-xs text-brand-ink-faint leading-relaxed">
        <span class="text-brand-ink-soft font-semibold">¹</span> Savings estimates are based on average diesel prices, assumed fuel discounts at participating stations, and the inputs you provided. Actual savings depend on stations used, fuel prices at the time of fill, route, and driving patterns, and are not guaranteed. Discounts up to $1.40/gallon reflect the deepest pricing observed at select partner locations and are not available at every station.
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <img
          src="/logo.png"
          alt="Versys"
          width="263"
          height="50"
          class="h-12 w-auto mb-4 opacity-95"
        />
        <p class="text-sm text-brand-ink-faint mb-3">
          The operating system for modern carriers.
        </p>
        <address class="text-xs text-brand-ink-faint not-italic leading-relaxed">
          400 S. 4th St, Suite 318<br />
          Las Vegas, NV 89101
        </address>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-wider text-brand-ink-soft mb-4">Product</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#tms" class="text-brand-ink-muted hover:text-brand-ink transition">TMS</a>
          </li>
          <li>
            <a href="#fuel" class="text-brand-ink-muted hover:text-brand-ink transition">Fuel Card</a>
          </li>
          <li>
            <a href="#ifta" class="text-brand-ink-muted hover:text-brand-ink transition">IFTA Help</a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-wider text-brand-ink-soft mb-4">Company</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:support@versysinc.com"
              class="text-brand-ink-muted hover:text-brand-ink transition"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-wider text-brand-ink-soft mb-4">Resources</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#faq" class="text-brand-ink-muted hover:text-brand-ink transition">FAQ</a>
          </li>
          <li>
            <a href="/privacy" class="text-brand-ink-muted hover:text-brand-ink transition">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="text-brand-ink-muted hover:text-brand-ink transition">Terms &amp; Conditions</a>
          </li>
        </ul>
      </div>
    </div>
    <div
      class="border-t border-white/5 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-xs text-brand-ink-faint"
    >
      <span>© {year} Versys Technologies Inc.</span>
      <span>Built by truckers, for truckers.</span>
    </div>
  </div>
</footer>
